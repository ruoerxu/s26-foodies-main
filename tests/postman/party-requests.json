    {
      "name": "GetParties",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Deleted party is not returned\", function () {",
              "    const json = pm.response.json();",
              "    const parties = Array.isArray(json.parties) ? json.parties : [];",
              "    const names = parties.map((party) => party && party.name);",
              "    pm.expect(names).to.not.include(\"FridayDinner\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],

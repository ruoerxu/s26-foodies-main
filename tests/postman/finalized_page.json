    {
      "name": "GetFinalizedPlan",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response contains restaurant and meeting details\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.plan).to.have.property('restaurant_name');",
              "    pm.expect(json.plan).to.have.property('meeting_date');",
              "    pm.expect(json.plan).to.have.property('meeting_time');",
